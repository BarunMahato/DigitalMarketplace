# ==============================================================================
# Digital Course & Asset Marketplace API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables to suit your local/production environment:
#   cp .env.example .env
#
# NOTE: Never commit sensitive credentials or production secret keys to version control.

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# Set DEBUG=0 in production. In development, keep 1 for full tracebacks.
DEBUG=1

# Comma-separated list of host/domain names that this Django site can serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Django Secret Key (Used for cryptographic signing)
SECRET_KEY=django-insecure-change-this-in-production-random-key-64-bytes-min

# Custom JWT signing secret key (defaults to SECRET_KEY if left empty)
JWT_SECRET_KEY=IT_IS_A_SECRET_KEY_REPLACE_FOR_PROD

# ------------------------------------------------------------------------------
# Database Settings (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_NAME=marketplace_db
DB_USER=root
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# Redis & Celery Settings
# ------------------------------------------------------------------------------
# Celery message broker and result backend (uses Redis DB 0)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Django Cache backend (uses isolated Redis DB 1 to prevent queue collisions)
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------
# Development: console backend writes HTML/plain text emails to terminal
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Marketplace <noreply@example.com>
